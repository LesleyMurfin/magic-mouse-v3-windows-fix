.DS_Store

# Git-ignore driver binaries EXCEPT the labeled PATH-A ship-blocker (if present).
# KMDF 2.0.4 scroll dest is MagicMouseDriver-kmdf-204-scroll.sys.
# MagicMouseDriver.sys is the Apr 30 restore name — never commit a second copy.
*.sys
!v1-binary-patch/applewirelessmouse-patched-pathA-SHIPBLOCKER.sys
!v1-binary-patch/installer/applewirelessmouse-patched-pathA-SHIPBLOCKER.sys

# Catalogs are produced on Windows after human sign. Do not commit unsigned cats.
*.cat

# Certificates EXCEPT release/. Never commit PFX / private keys.
*.cer
*.pfx
*.p12
!v1-binary-patch/MagicMouseFix.cer
!v1-binary-patch/installer/MagicMouseFix.cer

# Python (if used for scripts)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local research — private, never pushed
docs/research/

# Sample env for optional Jev/Kev enrichment (fail-open).
# Installed only with: install_aco_kit.py --with-jev
# Copy values into your shell; do not commit live secrets.
#
# Default: Jev is ACTIVE when JEV_URL is set (routed via AICostOptimizer).
# Fails open to local .aco/graph.db if unset or unreachable.

# Optional remote endpoint. Leave empty or unset when offline.
# JEV_URL=https://jev.example.invalid
JEV_URL=

# JEV_DISABLED=1 (optional override only; default active)

//
// FileVersion 2.0.4.6 - battery: prevent ACL scratch diversion on short reads (inCap < MM_MOUSE_REPORT_LEN) and learn control channel on device-initiated reconnect (BRB_L2CA_OPEN_CHANNEL_RESPONSE); COL02 0x90 battery stays readable.
// FileVersion 2.0.4.5 - battery after reconnect: the HID control channel handle is now learned from BRB_L2CA_OPEN_CHANNEL_RESPONSE (device-initiated reconnects) as well as BRB_L2CA_OPEN_CHANNEL (host-initiated opens), so MtControlHandle is no longer NULL after an idle disconnect and the COL02 Input 0x90 battery percent stays readable.
// FileVersion 2.0.4.4 - two fixes: (1) battery - control-channel 1-byte IN reads are no longer diverted into the ACL scratch, so the COL02 Input 0x90 GET_REPORT response survives (plus RemainingBufferSize restore); (2) scroll - every dragging contact emits its own wheel notches again (the single-reference-finger rule went silent whenever the lowest-id contact rested), with the default detent MM_SCROLL_STEP raised 8 -> 16 to keep sensitivity.
// FileVersion 2.0.4.3 - single-reference-finger scroll detent + registry-tunable ScrollStep; kernel HID SetFeature-via-sibling-PDO path removed (broke pointer+scroll live as 2.0.4.2).
// Canonical artifact: MagicMouseDriver-kmdf-2.0.4-scroll-<sha8>.sys
// INF dest / ServiceBinary: MagicMouseDriver-kmdf-204-scroll.sys
// Never ship a second MagicMouseDriver.sys (that name is the Apr 30 restore file).
//
// Distinct from:
//   MagicMouseDriver-kmdf-apr30-pointer-AD5D244B.sys      pointer-only (oem16)
//   MagicMouseDriver-kmdf-may20-pointerdead-559B136A.sys  FileVersion 2.0.2.0, refuse
//   SHA256 845435CE…                                      failed 2.0.4 oem26, refuse
//   applewirelessmouse-patched-pathA-SHIPBLOCKER.sys      PATH-A, never this product

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,0,4,6
 PRODUCTVERSION 2,0,4,6
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DRV
 FILESUBTYPE    VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Magic Mouse Driver KMDF 204 scroll"
            VALUE "FileDescription",  "KMDF 2.0.4.6 scroll (PID 0323). Dest MagicMouseDriver-kmdf-204-scroll.sys."
            VALUE "FileVersion",      "2.0.4.6"
            VALUE "InternalName",     "MagicMouseDriver-kmdf-204-scroll"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "MagicMouseDriver-kmdf-2.0.4-scroll-<sha8>.sys"
            VALUE "ProductName",      "MagicMouseDriver KMDF 2.0.4 scroll"
            VALUE "ProductVersion",   "2.0.4.6"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
